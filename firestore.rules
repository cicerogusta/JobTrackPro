rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    function validApplication(userId) {
      let d = request.resource.data;
      return d.keys().hasAll(['userId','company','role','location','workMode','appliedOn','status','jobUrl','notes','createdAt','updatedAt','deleted','revision'])
        && d.keys().hasOnly(['userId','company','role','location','workMode','appliedOn','status','jobUrl','notes','createdAt','updatedAt','deleted','revision'])
        && d.userId == userId
        && d.company is string && d.company.size() > 0 && d.company.size() <= 200
        && d.role is string && d.role.size() > 0 && d.role.size() <= 200
        && d.location is string && d.location.size() > 0 && d.location.size() <= 200
        && d.workMode in ['REMOTE','HYBRID','ON_SITE']
        && d.status in ['SAVED','APPLIED','INTERVIEW','OFFER','REJECTED']
        && d.appliedOn is string && d.appliedOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.jobUrl is string && d.jobUrl.size() <= 2048
        && (d.jobUrl == '' || d.jobUrl.matches('^https://[^/]+.*'))
        && d.notes is string && d.notes.size() <= 10000
        && d.createdAt is int && d.createdAt > 0
        && d.updatedAt is int && d.updatedAt >= d.createdAt
        && d.deleted is bool
        && d.revision is string && d.revision.size() == 36;
    }
    match /users/{userId}/applications/{applicationId} {
      allow read: if signedInAs(userId);
      allow create: if signedInAs(userId) && validApplication(userId);
      allow update: if signedInAs(userId) && validApplication(userId)
        && request.resource.data.createdAt == resource.data.createdAt
        && (request.resource.data.updatedAt > resource.data.updatedAt
            || (request.resource.data.updatedAt == resource.data.updatedAt
                && request.resource.data.revision >= resource.data.revision));
      // Deletions use tombstones so offline devices learn about them.
      allow delete: if false;
    }
  }
}
